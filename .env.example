# Local demo environment (OPS-001). Copy to .env and source before starting processes.
# Fake provider demo — no paid LLM keys required when config uses provider "fake".
#
# Real LLM / production template: .env.prod.example

# Infrastructure (matches tests/integration/support/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartoon
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Config loader (default: config/cartoon.yaml relative to CWD)
CARTOON_CONFIG_PATH=config/cartoon.yaml

# Fake AI provider credential (ACD-NFR-011)
FAKE_API_KEY=local-demo-fake-key

# Worker role (optional; prefer --role on cartoon-demo-worker CLI)
# CARTOON_DEMO_WORKER_ROLE=COLLECT
