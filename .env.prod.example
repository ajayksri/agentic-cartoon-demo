# Production / real-LLM environment template
#
# Usage:
#   1. Copy:  cp .env.prod.example .env.prod
#   2. Edit:  replace every CHANGE_ME with real values
#   3. Load:  set -a && source .env.prod && set +a
#      (repeat in every terminal running api / coordinator / workers / cli)
#   4. Pair with a production YAML config (see CARTOON_CONFIG_PATH below)
#
# Security (ACD-SEC-001, ACD-SEC-002):
#   - Never commit .env.prod or real API keys to git
#   - YAML config references env var *names* only (providers.*.api_key_env)
#   - The application does NOT auto-load .env files; you must export/source them
#     or inject variables via systemd, Docker, Kubernetes, etc.
#
# Credential scope:
#   - Only providers assigned to agents in config/cartoon.yaml are required
#   - Unused provider keys may be omitted (e.g. all-openai setup needs only OPENAI_API_KEY)
#
# Fake demo template: .env.example (uses provider "fake", no paid LLM keys)

# =============================================================================
# Application config
# =============================================================================

# Path to production YAML (see config/cartoon.prod.yaml — multi-provider template)
CARTOON_CONFIG_PATH=config/cartoon.prod.yaml

# =============================================================================
# Infrastructure (required — all long-running processes)
# =============================================================================

# PostgreSQL DSN (used by runtime persistence wiring)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/cartoon

# Redis DSN (task queue / streams)
REDIS_URL=redis://localhost:6379/0

# Referenced by config YAML infrastructure.postgres.user_env / password_env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional — only if config YAML sets infrastructure.redis.password_env: REDIS_PASSWORD
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# =============================================================================
# LLM provider credentials (required only for providers used by agents)
# =============================================================================
#
# Typical multi-provider layout (one provider per AI agent):
#   topic_selector     → gemini
#   scenario_generator → openai
#   critic             → anthropic
# → set GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY
#
# Single-provider layout (simplest):
#   all three agents → openai
# → set OPENAI_API_KEY only
#
# Provider IDs in config: openai | anthropic | gemini | kimi | fake

# OpenAI — required when any agent uses provider: openai
OPENAI_API_KEY=sk-CHANGE_ME

# Anthropic — required when any agent uses provider: anthropic
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Google Gemini — required when any agent uses provider: gemini
# (config key is api_key_env: GEMINI_API_KEY)
GEMINI_API_KEY=CHANGE_ME

# Moonshot / Kimi — required when any agent uses provider: kimi
MOONSHOT_API_KEY=CHANGE_ME

# Fake provider — NOT used in production; leave unset unless testing with fake
# FAKE_API_KEY=

# =============================================================================
# Operator CLI (optional — cartoon-demo-cli only)
# =============================================================================

# API base URL (default http://127.0.0.1:8000)
# CARTOON_API_URL=http://127.0.0.1:8000

# HTTP request timeout in seconds
# CARTOON_CLI_TIMEOUT=30

# Set to 1 to print tracebacks on CLI errors (debug only)
# CARTOON_CLI_DEBUG=0

# =============================================================================
# Worker process (optional)
# =============================================================================

# Default worker role when --role is omitted (prefer explicit --role in production)
# CARTOON_DEMO_WORKER_ROLE=COLLECT
